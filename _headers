  Cache-Control: no-cache

# V3 app layers — same no-cache treatment as the legacy core files, so a CSS
# fix never has to wait out an edge cache (the ?v= bump is belt, this is braces).
/assets/*
  Cache-Control: no-cache
/sale/css/*
  Cache-Control: no-cache
/sale/finance.js
  Cache-Control: no-cache
/sale/sw.js
  Cache-Control: no-cache

# Team portraits change while everything else in /assets/ is versioned by
# filename. Revalidate each visit; unchanged is a 304, changed is the new face.
/assets/team/*
  Cache-Control: no-cache

# The insight tree records voice notes. Site-wide the microphone is off (above);
# here, and only here, the page itself may ask for it.
/thing/*
  ! Permissions-Policy
  Permissions-Policy: geolocation=(), microphone=(self), camera=()
