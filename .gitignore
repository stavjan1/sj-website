# Local Netlify CLI state / cache
.netlify/

# OS / editor junk
.DS_Store
Thumbs.db
*.log

# Build output (none for this static site, kept for safety)
node_modules/

# Internal planning doc — not for deploy
UPGRADE_PLAN.md

# Background images: only the optimized bg-*.jpeg are committed; the large
# original uploads in sale/backgrounds/ are kept local only.
sale/backgrounds/*
!sale/backgrounds/bg-*.jpeg

# Claude Code local dev config
.claude/

# Supplier price harvest: the raw JSONL and the full normalized dump are
# regenerated by scripts/suppliers/ in minutes and would add ~10MB to the repo
# every weekly refresh. Only the two files the site actually serves are
# committed — data/materials/index.json and taxonomy.json.
data/materials/raw/
data/materials/erco.json

# Python bytecode from the supplier scripts
__pycache__/
*.pyc

# Local secrets. Wrangler reads .dev.vars for local dev and it holds the same
# keys as the Cloudflare dashboard — Gemini, Resend, Telegram, the invoicing
# providers. Nothing here is committed today; this exists so that stays true
# the first time anyone runs the functions locally.
.dev.vars
.dev.vars.*
.env
.env.*
!.env.example
.wrangler/
